{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Championship Studio",
  "version": "1.0.0",
  "identifier": "com.teebaan.championshipstudio",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Championship Studio",
        "width": 1440,
        "height": 920,
        "minWidth": 1060,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
